# BuildPlane local development configuration.
#
# Copy this file to .env and change values for your machine:
#
#   cp .env.example .env
#
# The committed defaults are synthetic local-development values only.
# Do not commit real API keys, production database URLs, or cloud credentials.

# PostgreSQL container settings used by Docker Compose.
POSTGRES_USER=buildplane
POSTGRES_PASSWORD=buildplane_dev_password
POSTGRES_DB=buildplane
BUILDPLANE_POSTGRES_PORT=5432

# Redis container settings used by Docker Compose.
BUILDPLANE_REDIS_PORT=6379

# Host-local service ports.
BUILDPLANE_API_PORT=8080
BUILDPLANE_AI_SERVICE_PORT=8090
BUILDPLANE_WEB_PORT=5173

# Host-local URLs for running Go/Python processes directly from your shell.
BUILDPLANE_DATABASE_URL=postgres://buildplane:buildplane_dev_password@localhost:5432/buildplane?sslmode=disable
BUILDPLANE_REDIS_URL=redis://localhost:6379/0
BUILDPLANE_AI_SERVICE_URL=http://localhost:8090
BUILDPLANE_MIGRATIONS_DIR=migrations

# Docker-internal URLs for services running inside docker-compose.
BUILDPLANE_DOCKER_DATABASE_URL=postgres://buildplane:buildplane_dev_password@postgres:5432/buildplane?sslmode=disable
BUILDPLANE_DOCKER_REDIS_URL=redis://redis:6379/0
BUILDPLANE_DOCKER_AI_SERVICE_URL=http://ai-service:8090
BUILDPLANE_DOCKER_MIGRATIONS_DIR=/migrations

# Runtime tuning.
BUILDPLANE_SCHEDULER_BATCH_SIZE=10
BUILDPLANE_SCHEDULER_INTERVAL=2s
BUILDPLANE_WORKER_LEASE_DURATION=30s
BUILDPLANE_WORKER_DRAIN_TIMEOUT=25s

# AI provider configuration.
# Use "mock" for deterministic local development.
# Use "openai" only when OPENAI_API_KEY is set in your private .env.
BUILDPLANE_AI_PROVIDER=mock
BUILDPLANE_AI_PROMPT_VERSION=issue_classifier_v1
OPENAI_API_KEY=

# Optional frontend override. Leave empty to use the Vite /api proxy locally.
VITE_BUILDPLANE_API_BASE_URL=
