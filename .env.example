DATABASE_URL=postgres://buildplane:buildplane@localhost:5432/buildplane?sslmode=disable
REDIS_ADDR=localhost:6379
KUBE_NAMESPACE=buildplane
RUNNER_IMAGE=buildplane-runner:local
RUNNER_SERVICE_ACCOUNT=buildplane-runner
INTERNAL_TOKEN=dev-internal-token
PUBLIC_BASE_URL=http://api.buildplane.svc.cluster.local:8080
LEASE_DURATION=30s
HEARTBEAT_INTERVAL=10s
RECONCILE_INTERVAL=10s
SCHEDULER_INTERVAL=2s
GLOBAL_ACTIVE_LIMIT=10
PER_TENANT_QUEUE_LIMIT=100
GLOBAL_QUEUE_LIMIT=1000
MAX_CPU_MILLIS_IN_FLIGHT=16000
MAX_MEMORY_MB_IN_FLIGHT=32768
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=buildplane-cache
S3_USE_SSL=false
SHADOW_SCHEDULER=true
